# ==============================================================================
# QR-Based School Attendance System - Environment Variables
# ==============================================================================
#
# DO NOT store real secrets or credentials in this file.
# Frontend applications (Teacher App & Parent App) only read variables starting with VITE_.
# Privileged service role keys and FCM Admin credentials MUST NEVER be included in frontend builds.

# ------------------------------------------------------------------------------
# 1. Supabase Public Configuration (Used by apps/teacher and apps/parent)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 2. Firebase / FCM Client Configuration (Used by apps/teacher and apps/parent)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-fcm-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key

# ------------------------------------------------------------------------------
# 3. Supabase Edge Functions Secrets (Set via `supabase secrets set`)
# Server-side ONLY. NEVER expose with VITE_ prefix.
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
