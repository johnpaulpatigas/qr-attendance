{
  "name": "qr-attendance",
  "version": "1.0.0",
  "private": true,
  "description": "QR-based school attendance system monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -c \"blue.bold,green.bold\" -n \"teacher,parent\" \"npm run dev:teacher\" \"npm run dev:parent\"",
    "dev:all": "npm run dev",
    "dev:teacher": "npm run dev --workspace=teacher",
    "dev:parent": "npm run dev --workspace=parent",
    "build:teacher": "npm run build --workspace=teacher",
    "build:parent": "npm run build --workspace=parent",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
