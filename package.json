{
  "name": "qr-attendance",
  "version": "1.0.0",
  "private": true,
  "description": "QR-based school attendance system monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -c \"blue.bold,green.bold\" -n \"teacher,parent\" \"npm run dev:teacher\" \"npm run dev:parent\"",
    "dev:all": "npm run dev",
    "dev:teacher": "npm run dev --workspace=teacher",
    "dev:parent": "npm run dev --workspace=parent",
    "build:teacher": "npm run build --workspace=teacher",
    "build:parent": "npm run build --workspace=parent",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cap:sync:teacher": "npm run build:teacher && npm run cap:sync --workspace=teacher",
    "cap:sync:parent": "npm run build:parent && npm run cap:sync --workspace=parent",
    "cap:sync": "npm run cap:sync:teacher && npm run cap:sync:parent",
    "cap:open:teacher": "npm run cap:open --workspace=teacher",
    "cap:open:parent": "npm run cap:open --workspace=parent",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:combined": "node scripts/migrate.mjs --combined"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "jeep-sqlite": "^2.8.0"
  }
}
